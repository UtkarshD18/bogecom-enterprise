<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="008-add-category-to-products" author="system">
        <addColumn tableName="products">
            <column name="category_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint baseTableName="products"
                                 baseColumnNames="category_id"
                                 constraintName="fk_products_category_id"
                                 referencedTableName="categories"
                                 referencedColumnNames="id"
                                 onDelete="SET NULL"/>
                                 
        <createIndex tableName="products" indexName="idx_products_category_id">
            <column name="category_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
