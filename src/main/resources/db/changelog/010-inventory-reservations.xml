<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="010-create-inventory-reservations" author="system">
        <createTable tableName="inventory_reservations">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="inventory_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="order_id" type="BIGINT"/>
            <column name="cart_id" type="BIGINT"/>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <!-- BaseEntity Columns -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(255)"/>
            <column name="version" type="INT" defaultValueNumeric="0"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="inventory_reservations"
                                 baseColumnNames="inventory_id"
                                 constraintName="fk_reservations_inventory_id"
                                 referencedTableName="inventory"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <createIndex tableName="inventory_reservations" indexName="idx_reservations_inventory_id">
            <column name="inventory_id"/>
        </createIndex>
        
        <createIndex tableName="inventory_reservations" indexName="idx_reservations_order_id">
            <column name="order_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
